# The build's updatePluginManifest task rewrites manifest.json with LF endings on every
# processResources, so git expects LF there and a build no longer leaves the file dirty.
src/main/resources/manifest.json text eol=lf

# The deprecation gate is a byte copy of the MMO's (mmo-family/mmo-skills), compared byte for byte: it stays LF on every checkout.
gradle/deprecation-gate.gradle text eol=lf
